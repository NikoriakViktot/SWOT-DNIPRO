# Environment & secrets — NEVER COMMIT
.env
*.env
*.token

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Data — large/raw
data/raw/**/*.nc
data/raw/**/*.part
data/logs/*.log
data/index/*.parquet

# Keep directory structure
!data/raw/.gitkeep
!data/raw/swot_riversp/.gitkeep
!data/raw/swot_lakesp/.gitkeep
!data/raw/swot_pixcvec_river/.gitkeep
!data/index/.gitkeep
!data/logs/.gitkeep

# IDE
.idea/
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# data
# `data/*`, not `data/`: git will not descend into an excluded DIRECTORY, so a
# negation inside it can never match. Excluding the entries instead leaves the
# directory itself traversable.
data/*
# ...except the historical tables. These are hand-transcribed from photographed
# monograph pages, no script can regenerate them, and the only other copy is the
# photographs. A few kB, and losing them costs a full re-transcription.
!data/historical/
*.tif
*.tiff
*.nc
*.hdf
*.h5
*.dim
*.data/


# logs
logs/
*.log

data

audit_runs/

# paper 1: the .docx builds are release assets, not history; working copies stay local
outputs/paper/*.docx
outputs/paper/*.orig.md
