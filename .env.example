# Copy this file to .env and fill in your token.
# WARNING: .env is in .gitignore — NEVER commit your real token!
#
# Get your Earthdata Bearer Token at:
#   https://urs.earthdata.nasa.gov/users/<your_username>/user_tokens
#
EARTHDATA_TOKEN=PASTE_YOUR_EARTHDATA_BEARER_TOKEN_HERE
Client_ID_CDSE=***
Client_secret_CDSE=**
username_CDSE=**
password_CDSE=**